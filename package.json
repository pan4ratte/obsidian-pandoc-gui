{
  "name": "obsidian-pandoc-gui",
  "version": "2.2.0",
  "description": "Export and import notes via Pandoc with a modern GUI both on desktop and mobile. Create templates for Word, PDF, LaTeX, HTML, EPUB, and many other formats, and install dozens of lua filters from the store.",
  "main": "main.js",
  "scripts": {
    "dev": "vite build -w -m development",
    "build": "vite build",
    "version-bump": "node scripts/version.mjs bump",
    "version": "node scripts/version.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "format-check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tools/**/*.ts\"",
    "format-fix": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tools/**/*.ts\"",
    "docs:catalogue": "node scripts/gen-catalogue.js",
    "docs:catalogue:check": "node scripts/gen-catalogue.js --check",
    "gen:references": "node scripts/gen-references.mjs",
    "gen:references:check": "node scripts/gen-references.mjs --check",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "pan4ratte",
  "license": "MIT",
  "repository": "https://github.com/pan4ratte/obsidian-pandoc-gui",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.8.0",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "semver": "^7.8.5",
    "solid-js": "^1.9.14"
  }
}
